{
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "index.html",
      "llms.txt"
    ],
    "rewrites": [
      {
        "source": "/llms.txt",
        "function": "llmsTxt"
      },
      {
        "source": "**",
        "function": "prerender"
      }
    ]
  },
  "functions": {
    "source": "functions"
  }
}
